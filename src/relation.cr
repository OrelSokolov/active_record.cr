# Relation(T): immutable query chain, 1:1 feel to ActiveRecord::Relation.
# WHERE fragments use `?` placeholders, converted to $n in build_sql.

module ActiveRecord
  struct Relation(T)
    include Enumerable(T)

    attr_reader model : T.class

    @wheres = [] of String
    @args = [] of DB::Any
    @orders = [] of String
    @limit_value : Int64? = nil
    @offset_value : Int64? = nil
    @where_hash = {} of String => ActiveRecord::Value
    @groups = [] of String
    @havings = [] of String
    @having_args = [] of DB::Any
    @distinct_flag = false
    @none_flag = false
    @joins = [] of String
    @annotation : String? = nil
    @select_values : Array(String)? = nil
    @lock_clause : String? = nil
    @readonly_flag = false
    @strict_flag = false
    @includes_values = [] of String
    @eager_load_values = [] of String
    @references_values = [] of String

    def initialize(@model : T.class)
    end

    protected def initialize(@model : T.class, @wheres : Array(String),
                             @args : Array(DB::Any), @orders : Array(String),
                             @limit_value : Int64?, @offset_value : Int64?)
    end

    protected def initialize(@model : T.class, @wheres : Array(String),
                             @args : Array(DB::Any), @orders : Array(String),
                             @limit_value : Int64?, @offset_value : Int64?,
                             @where_hash : Hash(String, ActiveRecord::Value))
    end

    protected def initialize(@model : T.class, @wheres : Array(String),
                             @args : Array(DB::Any), @orders : Array(String),
                             @limit_value : Int64?, @offset_value : Int64?,
                             @where_hash : Hash(String, ActiveRecord::Value),
                             @groups : Array(String), @havings : Array(String),
                             @having_args : Array(DB::Any), @distinct_flag : Bool,
                             @none_flag : Bool, @joins : Array(String),
                             @annotation : String?,
                             @select_values : Array(String)? = nil,
                             @lock_clause : String? = nil,
                             @readonly_flag : Bool = false,
                             @strict_flag : Bool = false,
                             @includes_values : Array(String) = [] of String,
                             @eager_load_values : Array(String) = [] of String,
                             @references_values : Array(String) = [] of String)
    end

    private def copy : Relation(T)
      Relation(T).new(@model, @wheres.dup, @args.dup, @orders.dup,
        @limit_value, @offset_value, @where_hash.dup, @groups.dup,
        @havings.dup, @having_args.dup, @distinct_flag, @none_flag,
        @joins.dup, @annotation, @select_values.try(&.dup), @lock_clause,
        @readonly_flag, @strict_flag, @includes_values.dup,
        @eager_load_values.dup, @references_values.dup)
    end

    # Crystal forbids `r.@ivar = value` on another instance: chainable
    # methods that REPLACE a part go through this constructor instead.
    private def rebuild(*, wheres = @wheres, args = @args, orders = @orders,
                        limit_value = @limit_value, offset_value = @offset_value,
                        where_hash = @where_hash, groups = @groups,
                        havings = @havings, having_args = @having_args,
                        distinct_flag = @distinct_flag, none_flag = @none_flag,
                        joins = @joins, annotation_text = @annotation,
                        select_values = @select_values,
                        lock_clause = @lock_clause,
                        readonly_flag = @readonly_flag,
                        strict_flag = @strict_flag,
                        includes_values = @includes_values,
                        eager_load_values = @eager_load_values,
                        references_values = @references_values) : Relation(T)
      Relation(T).new(@model, wheres, args, orders, limit_value, offset_value,
        where_hash, groups, havings, having_args, distinct_flag, none_flag,
        joins, annotation_text, select_values, lock_clause, readonly_flag,
        strict_flag, includes_values, eager_load_values, references_values)
    end

    private def quote(col : String) : String
      %("#{col.gsub('"', "")}")
    end

    private def quoted_table : String
      %("#{model.table_name.gsub('"', "")}")
    end

    # The model's primary key column (quoted), used wherever Rails would
    # default to the pk (ordering, batching, JOIN targets).
    private def pk_col : String
      %("#{model.primary_key.gsub('"', "")}")
    end

    # With JOINs present, columns generated by this Relation get a table
    # prefix (Rails qualifies everywhere; we only do it on the join path).
    private def maybe_qualify(fragment : String) : String
      # Fragments that already carry a qualifier ("rooms"."type" from a
      # cross-model merge) pass through untouched.
      if !@joins.empty? && fragment.starts_with?('"') && !fragment.includes?('.')
        "#{quoted_table}.#{fragment}"
      else
        fragment
      end
    end

    private def select_list : String
      if sv = @select_values
        sv.map { |c| select_term(c) }.join(", ")
      else
        cols = model.__column_names.map { |c| %("#{c.gsub('"', "")}") }
        @joins.empty? ? cols.join(", ") : cols.map { |c| "#{quoted_table}.#{c}" }.join(", ")
      end
    end

    # A select value is either a bare column (optionally table-qualified)
    # or a raw SQL fragment passed through unchanged.
    private def select_term(col : String) : String
      return col unless col.matches?(/\A\w+(\.\w+)?\z/)
      parts = col.split('.').map { |p| %("#{p.gsub('"', "")}") }
      if !@joins.empty? && !col.includes?('.')
        "#{quoted_table}.#{parts.first}"
      else
        parts.join(".")
      end
    end

    # --- chainable ---

    def where(condition : String, *args) : Relation(T)
      r = copy
      r.@wheres << "(" + condition + ")"
      args.each { |a| r.@args << a.as(DB::Any) }
      r
    end

    def where(**opts) : Relation(T)
      r = copy
      opts.each do |key, value|
        col = quote(model.__resolve_column(key.to_s))
        case value
        when Range
          r.@wheres << "#{col} BETWEEN ? AND ?"
          r.@args << value.begin.as(DB::Any) << value.end.as(DB::Any)
        else
          stored = value.is_a?(Int32) ? value.to_i64 : value
          r.@where_hash[key.to_s] = stored.as(ActiveRecord::Value)
          if value.nil?
            r.@wheres << "#{col} IS NULL"
          elsif value.is_a?(Array)
            return r if value.empty?
            r.@wheres << "#{col} IN (#{value.map { "?" }.join(", ")})"
            value.each { |v| r.@args << v.as(DB::Any) }
          elsif (str = value.as?(String)) && sti_type_value?(key.to_s, str)
            # STI type column: a namespaced value matches both spellings —
            # "Rooms::Open" (reference seeds) and "Open" (rows written by
            # the shard itself, see the default STI filter in Base.all).
            r.@wheres << "#{col} IN (?, ?)"
            r.@args << str.as(DB::Any) << str.split("::").last.as(DB::Any)
          else
            r.@wheres << "#{col} = ?"
            r.@args << value.as(DB::Any)
          end
        end
      end
      r
    end

    def not(**opts) : Relation(T)
      r = copy
      opts.each do |key, value|
        col = quote(key.to_s)
        case value
        when Nil
          r.@wheres << "#{col} IS NOT NULL"
        when Range
          r.@wheres << "#{col} NOT BETWEEN ? AND ?"
          r.@args << value.begin.as(DB::Any) << value.end.as(DB::Any)
        when Array
          if value.empty?
            r.@wheres << "1=1"
          else
            r.@wheres << "#{col} NOT IN (#{value.map { "?" }.join(", ")})"
            value.each { |v| r.@args << v.as(DB::Any) }
          end
        else
          if (str = value.as?(String)) && sti_type_value?(key.to_s, str)
            # STI type column: see where(**opts) — both spellings excluded.
            r.@wheres << "#{col} NOT IN (?, ?)"
            r.@args << str.as(DB::Any) << str.split("::").last.as(DB::Any)
          else
            r.@wheres << "#{col} != ?"
            r.@args << value.as(DB::Any)
          end
        end
      end
      r
    end

    # True for a namespaced value on the STI type column — the case the
    # where/not IN-both-spellings expansion handles (see where(**opts)).
    private def sti_type_value?(key : String, value : String) : Bool
      value.includes?("::") && key == "type" && model.__has_type_column?
    end

    # --- introspection -------------------------------------------------------

    # WHERE fragments paired with their bind arguments (`?` placeholders
    # inside each fragment, arguments in order). Rails' where_values subset.
    def where_values : Array({String, Array(DB::Any)})
      paired = [] of {String, Array(DB::Any)}
      index = 0
      @wheres.each do |fragment|
        count = fragment.count('?')
        args = Array(DB::Any).new(count) { |i| @args[index + i] }
        index += count
        paired << {fragment, args}
      end
      paired
    end

    # Equality conditions from `where(col: value)` calls (Rails'
    # where_values_hash; string fragments are not represented).
    def where_values_hash : Hash(String, ActiveRecord::Value)
      @where_hash.dup
    end

    # Internal readers for cross-model #merge (private ivars are only
    # reachable within the same generic instantiation).
    def __orders : Array(String)
      @orders
    end

    def __limit_value : Int64?
      @limit_value
    end

    def __offset_value : Int64?
      @offset_value
    end

    def __joins_empty? : Bool
      @joins.empty?
    end

    # Internal (excluding): pk-only SELECT of this relation (used as a
    # NOT IN subquery by another relation of the same model).
    def __pk_subquery : Tuple(String, Array(DB::Any))
      build_sql(pk_col, @orders)
    end

    # Rails #or: structurally compatible relations; the right side may
    # only carry WHEREs, everything else raises.
    def or(other : Relation(T)) : Relation(T)
      incompatible = [] of String
      incompatible << "limit" unless other.@limit_value.nil?
      incompatible << "offset" unless other.@offset_value.nil?
      incompatible << "order" unless other.@orders.empty?
      unless incompatible.empty?
        raise ArgumentError.new(
          "Relation passed to #or must be structurally compatible. Incompatible values: #{incompatible}")
      end
      left = @wheres.empty? ? "1=0" : @wheres.map { |w| maybe_qualify(w) }.join(" AND ")
      right = other.@wheres.empty? ? "1=0" : other.@wheres.map { |w| maybe_qualify_in(w, other.@joins.empty?) }.join(" AND ")
      rebuild(wheres: ["(#{left}) OR (#{right})"], args: @args + other.@args)
    end

    def maybe_qualify_in(fragment : String, has_joins : Bool) : String
      if !has_joins && fragment.starts_with?('"') && !fragment.includes?('.')
        "#{quoted_table}.#{fragment}"
      else
        fragment
      end
    end

    # Rails #merge: the right side's values win (order/limit when set).
    # Cross-model merges (Membership.joins(:room).merge(Room.directs)) are
    # supported like Rails' scope merging: the right side's bare column
    # conditions are qualified with the right side's table.
    def merge(other : Relation(U)) : Relation(T) forall U
      right_wheres = [] of String
      right_args = [] of DB::Any
      other_table = %("#{other.model.table_name.gsub('"', "")}")
      other.where_values.each do |fragment, fargs|
        if fragment.starts_with?('"') && other.__joins_empty?
          right_wheres << "#{other_table}.#{fragment}"
        else
          right_wheres << fragment
        end
        right_args.concat(fargs)
      end
      rebuild(
        wheres: @wheres + right_wheres,
        args: @args + right_args,
        orders: other.__orders.empty? ? @orders : other.__orders,
        limit_value: other.__limit_value || @limit_value,
        offset_value: other.__offset_value || @offset_value
      )
    end

    # Rails excluding: drops the given records from the relation. A relation
    # argument becomes a NOT IN subquery (Rails keeps it a subquery too);
    # records are excluded by primary key.
    def excluding(other : Relation(T)) : Relation(T)
      sub_sql, sub_args = other.__pk_subquery
      # The subquery arrives with $n placeholders (build_sql form); convert
      # back to ? so the embedding relation renumbers every placeholder in
      # one sequence with its own binds.
      sub_sql = sub_sql.gsub(/\$\d+/) { "?" }
      r = copy
      r.@wheres << "#{pk_col} NOT IN (#{sub_sql})"
      r.@args.concat(sub_args)
      r
    end

    def excluding(*records : T) : Relation(T)
      ids = records.map(&.id).compact.map { |i| i.as(DB::Any) }
      return none if ids.empty?
      r = copy
      r.@wheres << "#{pk_col} NOT IN (#{ids.map { "?" }.join(", ")})"
      r.@args.concat(ids)
      r
    end

    def order(*cols : String | Symbol) : Relation(T)
      r = copy
      cols.each { |c| r.@orders << order_term(c.to_s, nil) }
      r
    end

    def order(**opts) : Relation(T)
      r = copy
      opts.each do |col, dir| r.@orders << order_term(col.to_s, dir) end
      r
    end

    # Rails reorder: replaces the existing order.
    def reorder(*cols : String | Symbol) : Relation(T)
      rebuild(orders: cols.to_a.map { |c| order_term(c.to_s, nil) })
    end

    def reorder(**opts) : Relation(T)
      rebuild(orders: opts.map { |col, dir| order_term(col.to_s, dir) })
    end

    # Rails in_order_of(:id, [3, 1, 2]) — WHERE id IN (...) ordered by the
    # given array position (PostgreSQL ARRAY_POSITION).
    def in_order_of(col : String | Symbol, values : Array(Int64 | Int32)) : Relation(T)
      frag = "#{quote(col.to_s)} IN (#{values.map { "?" }.join(", ")})"
      order = "ARRAY_POSITION(ARRAY[#{values.map { |v| "#{v}::bigint" }.join(", ")}], #{quote(col.to_s)})"
      rebuild(wheres: @wheres + [frag], args: @args + values.map { |v| v.as(DB::Any) }, orders: [order])
    end

    private def order_term(col : String, dir) : String
      parts = col.split(/\s+/)
      # Raw SQL expressions (function calls like `lower(name)`) pass through
      # unquoted — quoting them would turn the call into a constant string
      # literal in SQLite, silently dropping the ordering.
      return col if parts[0].includes?('(')
      # Qualified columns ("rooms.updated_at") keep their qualifier as a
      # quoted pair — quoting the whole token would hide the dot from SQLite.
      base = if parts[0].includes?('.')
               parts[0].split('.').map { |p| quote(p) }.join(".")
             else
               quote(parts[0])
             end
      suffix = if parts.size > 1
                 " " + parts[1..].join(" ").upcase
               elsif dir
                 case dir.to_s.downcase
                 when "desc" then " DESC"
                 when "asc"  then " ASC"
                 else " " + dir.to_s.upcase
                 end
               else
                 ""
               end
      base + suffix
    end

    def limit(n : Int) : Relation(T)
      rebuild(limit_value: n.to_i64)
    end

    def offset(n : Int) : Relation(T)
      rebuild(offset_value: n.to_i64)
    end

    def reverse_order : Relation(T)
      orders = @orders.empty? ? ["#{pk_col} DESC"] : @orders.map do |o|
        if o =~ / DESC\z/
          o.sub(/ DESC\z/, " ASC")
        elsif o =~ / ASC\z/
          o.sub(/ ASC\z/, " DESC")
        else
          o + " DESC"
        end
      end
      rebuild(orders: orders)
    end

    def group(*cols : String | Symbol) : Relation(T)
      r = copy
      cols.each { |c| r.@groups << maybe_qualify(quote(c.to_s)) }
      r
    end

    def having(condition : String, *args) : Relation(T)
      r = copy
      r.@havings << "(" + condition + ")"
      args.each { |a| r.@having_args << a.as(DB::Any) }
      r
    end

    def distinct(value : Bool = true) : Relation(T)
      rebuild(distinct_flag: value)
    end

    # Association-name JOIN by convention: posts.joins(:comments) →
    # INNER JOIN comments ON comments.post_id = posts.id (has_many/has_one
    # FK convention; belongs_to-side joins are not supported yet).
    def joins(*names : String | Symbol) : Relation(T)
      r = copy
      names.each do |name|
        n = name.to_s
        if n.includes?(' ')
          r.@joins << n # raw SQL fragment
        else
          r.@joins << join_clause(n, "INNER JOIN")
        end
      end
      r
    end

    def left_outer_joins(*names : String | Symbol) : Relation(T)
      r = copy
      names.each do |name|
        n = name.to_s
        if n.includes?(' ')
          r.@joins << n
        else
          r.@joins << join_clause(n, "LEFT OUTER JOIN")
        end
      end
      r
    end

    private def join_clause(name : String, kind : String) : String
      # Reflection-based: declared associations carry their kind, class and
      # foreign key (joins(:room) on Membership → rooms.id = memberships.room_id).
      if (assoc = model.__associations.find { |a| a[:name] == name })
        table = quote(assoc[:klass].table_name.gsub('"', ""))
        if assoc[:kind] == "belongs_to"
          "#{kind} #{table} ON #{table}.#{quote(assoc[:klass].primary_key)} = #{quoted_table}.#{quote(assoc[:foreign_key])}"
        else
          "#{kind} #{table} ON #{table}.#{quote(assoc[:foreign_key])} = #{quoted_table}.#{quote(model.primary_key)}"
        end
      else
        # Convention fallback for undeclared associations (has_many/has_one
        # FK convention): posts.joins(:comments) → comments.post_id = posts.id.
        table = name.ends_with?('s') ? name : name + "s"
        owner_singular = model.table_name.chomp("s")
        fk = "#{owner_singular}_id"
        "#{kind} #{quote(table)} ON #{quote(table)}.#{quote(fk)} = #{quoted_table}.#{quote(model.primary_key)}"
      end
    end

    def none : Relation(T)
      rebuild(none_flag: true)
    end

    def annotate(message : String) : Relation(T)
      rebuild(annotation_text: message)
    end

    # Rails select: appends columns to the SELECT list (simple column
    # names; raw SQL fragments pass through but cannot be materialized
    # into record attributes). reselect replaces the list.
    def select(*cols : String | Symbol) : Relation(T)
      rebuild(select_values: (@select_values || [] of String) + cols.to_a.map(&.to_s))
    end

    def reselect(*cols : String | Symbol) : Relation(T)
      rebuild(select_values: cols.to_a.map(&.to_s))
    end

    # Rails lock: appends a row-lock clause to the generated SELECT
    # (default "FOR UPDATE", like `lock: true` in Rails).
    def lock(clause : String = "FOR UPDATE") : Relation(T)
      rebuild(lock_clause: clause)
    end

    def readonly(value : Bool = true) : Relation(T)
      rebuild(readonly_flag: value)
    end

    def strict_loading(value : Bool = true) : Relation(T)
      rebuild(strict_flag: value)
    end

    # Rails includes: preload the associations with one extra query per
    # association after materializing the parent records (preload
    # strategy; polymorphic/through/HABTM associations are not preloaded
    # and still load lazily).
    def includes(*names : String | Symbol) : Relation(T)
      rebuild(includes_values: @includes_values + names.to_a.map(&.to_s))
    end
    def preload(*names : String | Symbol) : Relation(T)
      includes(*names)
    end

    # Nested Rails form: includes(creator: :avatar_attachment),
    # includes(boosts: { booster: :avatar_attachment }). The nested spec is
    # flattened into dot-paths ("creator.avatar_attachment") stored in
    # includes_values and preloaded level by level.
    def includes(**nested : Symbol | String | NamedTuple) : Relation(T)
      rebuild(includes_values: @includes_values + NestedSpec.flatten(nested))
    end
    def preload(**nested : Symbol | String | NamedTuple) : Relation(T)
      includes(**nested)
    end

    # Mixed form: preload(:room, creator: :avatar_attachment).
    def includes(*names : String | Symbol, **nested : Symbol | String | NamedTuple) : Relation(T)
      rebuild(includes_values: @includes_values + names.to_a.map(&.to_s) + NestedSpec.flatten(nested))
    end
    def preload(*names : String | Symbol, **nested : Symbol | String | NamedTuple) : Relation(T)
      includes(*names, **nested)
    end

    # Helpers to flatten a nested preload/includes spec into dot-paths.
    module NestedSpec
      def self.flatten(spec : NamedTuple) : Array(String)
        paths = [] of String
        spec.each do |key, value|
          prefix = key.to_s
          case value
          when Symbol, String then paths << "#{prefix}.#{value}"
          when NamedTuple
            flatten(value).each { |sub| paths << "#{prefix}.#{sub}" }
          else
            raise ArgumentError.new("unsupported preload spec for #{prefix}: #{value.class}")
          end
        end
        paths
      end
    end

    # Rails eager_load: materialize with a single LEFT OUTER JOIN query
    # (has_many/belongs_to; other kinds fall back to lazy loading).
    def eager_load(*names : String | Symbol) : Relation(T)
      rebuild(eager_load_values: @eager_load_values + names.to_a.map(&.to_s))
    end

    # Rails references: forces includes(…) of the referenced tables to use
    # the single-query eager_load strategy.
    def references(*names : String | Symbol) : Relation(T)
      rebuild(references_values: @references_values + names.to_a.map(&.to_s))
    end

    # Rails Relation#merge: combines another relation of the same model.
    # where fragments concatenate (AND), orders concatenate, includes /
    # eager_load / references union; limit / offset / select / annotation
    # take the other's value when set there; distinct / none are OR-ed.
    def merge(other : Relation(T)) : Relation(T)
      rebuild(
        wheres: @wheres + other.@wheres,
        args: @args + other.@args,
        orders: @orders + other.@orders,
        limit_value: other.@limit_value || @limit_value,
        offset_value: other.@offset_value || @offset_value,
        where_hash: @where_hash.merge(other.@where_hash),
        groups: @groups + other.@groups,
        havings: @havings + other.@havings,
        having_args: @having_args + other.@having_args,
        distinct_flag: @distinct_flag || other.@distinct_flag,
        none_flag: @none_flag || other.@none_flag,
        joins: @joins + other.@joins,
        annotation_text: other.@annotation || @annotation,
        select_values: other.@select_values || @select_values,
        lock_clause: other.@lock_clause || @lock_clause,
        readonly_flag: @readonly_flag || other.@readonly_flag,
        strict_flag: @strict_flag || other.@strict_flag,
        includes_values: @includes_values + (other.@includes_values - @includes_values),
        eager_load_values: @eager_load_values + (other.@eager_load_values - @eager_load_values),
        references_values: @references_values + (other.@references_values - @references_values),
      )
    end

    # Rails chainability: model scopes (class methods returning a Relation)
    # are callable on a relation — `Message.where(...).ordered`. The call is
    # forwarded to the model class and merged into this relation (AND for
    # where, union for includes). Unknown methods fail to compile against
    # the model class, so typos are caught at compile time.
    macro method_missing(call)
      {% model = @type.type_vars.first %}
      sc = {{ model }}.{{ call.name }}({{ call.args.splat }})
      merge(sc)
    end

    def explain : String
      sql, args = build_sql(select_list, @orders.empty? ? [] of String : @orders)
      plan = [] of String
      Base.__session.query("EXPLAIN #{sql}", args: args) do |rs|
        rs.each { plan << rs.read(String) }
      end
      "EXPLAIN for: #{sql}\n#{plan.join("\n")}"
    end

    # --- except / only ------------------------------------------------------

    def except(*parts : Symbol) : Relation(T)
      wheres = @wheres
      args = @args
      orders = @orders
      limit_v = @limit_value
      offset_v = @offset_value
      groups = @groups
      havings = @havings
      distinct_f = @distinct_flag
      parts.each do |part|
        case part
        when :where  then wheres = [] of String; args = [] of DB::Any
        when :order  then orders = [] of String
        when :limit  then limit_v = nil
        when :offset then offset_v = nil
        when :group  then groups = [] of String
        when :having then havings = [] of String
        when :distinct then distinct_f = false
        end
      end
      rebuild(wheres: wheres, args: args, orders: orders, limit_value: limit_v,
        offset_value: offset_v, groups: groups, havings: havings,
        distinct_flag: distinct_f)
    end

    def only(*parts : Symbol) : Relation(T)
      wheres = [] of String
      args = [] of DB::Any
      orders = [] of String
      groups = [] of String
      havings = [] of String
      parts.each do |part|
        case part
        when :where  then wheres = @wheres.dup; args = @args.dup
        when :order  then orders = @orders.dup
        when :group  then groups = @groups.dup
        when :having then havings = @havings.dup
        end
      end
      rebuild(wheres: wheres, args: args, orders: orders, groups: groups,
        havings: havings, limit_value: nil, offset_value: nil)
    end

    # Finds the first record matching the where-conditions or creates one
    # from those conditions merged with `values`.
    def first_or_create(values : Hash(String, ActiveRecord::Value) = {} of String => ActiveRecord::Value) : T
      found = first
      return found if found
      record = model.new
      record.assign_attributes(@where_hash.merge(values))
      record.save
      record
    end

    # --- bulk operations ----------------------------------------------------

    def update_all(values : Hash(String, ActiveRecord::Value)) : Int64
      return 0_i64 if @none_flag || values.empty?
      sets_sql = values.keys.map { |k| %("#{k.gsub('"', "")}") + " = ?" }.join(", ")
      full = "UPDATE #{quoted_table} SET #{sets_sql}#{where_fragment}"
      args = values.values.map { |v| v.as(DB::Any) } + @args
      Base.__session.exec(placeholder_sql(full), args: args).rows_affected
    end

    def delete_all : Int64
      return 0_i64 if @none_flag
      sql = placeholder_sql("DELETE FROM #{quoted_table}#{where_fragment}")
      Base.__session.exec(sql, args: @args).rows_affected
    end

    def destroy_all : Array(T)
      return [] of T if @none_flag
      to_a.map(&.destroy)
    end

    def touch_all : Int64
      return 0_i64 if @none_flag
      full = "UPDATE #{quoted_table} SET #{quote("updated_at")} = ?#{where_fragment}"
      Base.__session.exec(placeholder_sql(full), args: [Time.utc.as(DB::Any)] + @args).rows_affected
    end

    # " WHERE w1 AND w2" (fragments keep `?` placeholders) or "".
    private def where_fragment : String
      return "" if @wheres.empty?
      " WHERE " + @wheres.map { |w| maybe_qualify(w) }.join(" AND ")
    end

    private def placeholder_sql(sql : String) : String
      counter = 0
      sql.gsub(/\?/) { counter += 1; "$#{counter}" }
    end

    # --- SQL building -------------------------------------------------------

    private def build_sql(cols : String, orders : Array(String),
                          limit_override : Int64? = nil) : Tuple(String, Array(DB::Any))
      counter = 0
      where_sql = @wheres.map { |w| maybe_qualify(w).gsub(/\?/) { counter += 1; "$#{counter}" } }.join(" AND ")
      having_sql = @havings.map { |h| h.gsub(/\?/) { counter += 1; "$#{counter}" } }.join(" AND ")
      lim = limit_override || @limit_value
      sql = String.build do |io|
        io << "SELECT "
        io << "DISTINCT " if @distinct_flag
        io << cols << " FROM " << quoted_table
        @joins.each { |j| io << " " << j }
        io << " WHERE " << where_sql unless where_sql.empty?
        io << " GROUP BY " << @groups.join(", ") unless @groups.empty?
        io << " HAVING " << having_sql unless having_sql.empty?
        unless orders.empty?
          qualified = @joins.empty? ? orders : orders.map { |o| qualify_order(o) }
          io << " ORDER BY " << qualified.join(", ")
        end
        io << " LIMIT " << lim if lim
        io << " OFFSET " << @offset_value if @offset_value
        io << " #{@lock_clause}" if @lock_clause
        io << " /* #{@annotation} */" if @annotation
      end
      args = @args + @having_args
      {sql, args}
    end

    private def qualify_order(term : String) : String
      if term.starts_with?('"')
        "#{quoted_table}.#{term}"
      else
        term
      end
    end

    def to_sql : String
      build_sql(select_list, @orders.empty? ? ["#{pk_col} ASC"] : @orders).first
    end

    # --- materialization ------------------------------------------------------

    def each(& : T ->) : Nil
      return if @none_flag
      # eager_load strategy: one LEFT OUTER JOIN query (explicit, or the
      # includes+references switch — Rails semantics).
      eager_name = @eager_load_values.first?
      unless eager_name
        @includes_values.each do |i|
          if (tbl = T.__assoc_table(i)) && @references_values.includes?(tbl)
            eager_name = i
            break
          end
        end
      end
      if eager_name
        records = T.__eager_load(eager_name, @wheres, @args, @orders,
          @limit_value, @offset_value)
        records.each do |record|
          record.readonly = @readonly_flag
          record.strict_loading = @strict_flag
        end
        rest = (@includes_values + @eager_load_values).reject { |n| n == eager_name }
        rest.each do |assoc|
          if assoc.includes?('.')
            T.__preload_path(assoc.split('.'), records)
          else
            T.__preload_assoc(assoc, records)
          end
        end
        records.each { |record| yield record }
        return
      end
      names = @select_values || model.__column_names
      sql, args = build_sql(select_list, @orders.empty? ? [] of String : @orders)
      records = [] of T
      Base.__session.query(sql, args: args) do |rs|
        rs.each do
          record = T.__from_row_cols(rs, names)
          record.readonly = @readonly_flag
          record.strict_loading = @strict_flag
          records << record
        end
      end
      unless @includes_values.empty?
        @includes_values.each do |assoc|
          if assoc.includes?('.')
            T.__preload_path(assoc.split('.'), records)
          else
            T.__preload_assoc(assoc, records)
          end
        end
      end
      records.each { |record| yield record }
    end

    def empty? : Bool
      !exists?
    end

    # Rails ActiveRecord::Relation#any? — without a block it's !empty?
    # (an EXISTS probe), not an Enumerable load.
    def any? : Bool
      !empty?
    end

    def exists? : Bool
      return false if @none_flag
      sql, args = build_sql("1", [] of String, limit_override: 1_i64)
      Base.__session.query_one?(sql, args: args, as: Int32) ? true : false
    end

    # exists?(title: "x") — conditions form.
    def exists?(**opts) : Bool
      return false if @none_flag
      where(**opts).exists?
    end

    # Without GROUP BY → total count; with GROUP BY → {group value => count}.
    def count : Int64 | Hash(ActiveRecord::Value, Int64)
      return 0_i64 if @none_flag
      if @groups.empty?
        sql, args = build_sql("count(*)", [] of String)
        Base.__session.query_one(sql, args: args, as: Int64)
      else
        sql, args = build_sql("#{@groups.join(", ")}, count(*)", [] of String)
        result = {} of ActiveRecord::Value => Int64
        Base.__session.query(sql, args: args) do |rs|
          rs.each do
            key = rs.read(ActiveRecord::Value)
            result[key] = rs.read(Int64)
          end
        end
        result
      end
    end

    def size : Int64 | Hash(ActiveRecord::Value, Int64)
      count
    end

    def pluck(col : String | Symbol) : Array(ActiveRecord::Value)
      return [] of ActiveRecord::Value if @none_flag
      sql, args = build_sql(maybe_qualify(quote(col.to_s)), @orders.empty? ? [] of String : @orders)
      values = [] of ActiveRecord::Value
      Base.__session.query(sql, args: args) do |rs|
        rs.each { values << rs.read(ActiveRecord::Value) }
      end
      values
    end

    def pick(col : String | Symbol) : ActiveRecord::Value
      limit(1).pluck(col).first?
    end

    def ids : Array(Int64)
      pluck(model.primary_key).map { |v| v.as(Int64) }
    end

    def take : T?
      limit(1).to_a.first?
    end

    def first : T?
      r = @orders.empty? ? order(model.primary_key) : self
      r.limit(1).to_a.first?
    end

    def first! : T
      first || raise ActiveRecord::RecordNotFound.new(
        "Couldn't find #{model} (first)")
    end

    def last : T?
      r = @orders.empty? ? order(model.primary_key) : self
      r.reverse_order.limit(1).to_a.first?
    end

    def find(id : Int64 | Int32 | String) : T
      find?(id) || raise ActiveRecord::RecordNotFound.new(
        "Couldn't find #{model} with 'id'=#{id}")
    end

    def find?(id : Int64 | Int32 | String) : T?
      pk_value = case id
                 in Int64, Int32 then id.to_i64
                 in String
                   parsed = id.to_i64?
                   return nil unless parsed
                   parsed
                 end
      where(%("#{model.primary_key}" = ?), pk_value).first
    end

    def find_by(**opts) : T?
      where(**opts).first
    end

    def find_by!(**opts) : T
      find_by(**opts) || raise ActiveRecord::RecordNotFound.new(
        "Couldn't find #{model} with #{opts.map { |k, v| "#{k}=#{v}" }.join(" ")}")
    end

    def sole : T
      records = limit(2).to_a
      case records.size
      when 1 then records.first
      when 0 then raise ActiveRecord::RecordNotFound.new("Couldn't find #{model} (sole)")
      else        raise ActiveRecord::RecordNotFound.new("Multiple #{model} found")
      end
    end

    def find_each(batch_size : Int32 = 1000, & : T ->) : Nil
      last_id = 0_i64
      loop do
        batch = where("#{pk_col} > ?", last_id)
          .order(model.primary_key)
          .limit(batch_size)
          .to_a
        break if batch.empty?
        batch.each do |record|
          yield record
          last_id = record.id.not_nil!
        end
        break if batch.size < batch_size
      end
    end

    def find_in_batches(batch_size : Int32 = 1000, & : Array(T) ->) : Nil
      last_id = 0_i64
      loop do
        batch = where("#{pk_col} > ?", last_id)
          .order(model.primary_key)
          .limit(batch_size)
          .to_a
        break if batch.empty?
        yield batch
        last_id = batch.last.id.not_nil!
        break if batch.size < batch_size
      end
    end

    def in_batches(of batch_size : Int32 = 1000, & : Relation(T) ->) : Nil
      last_id = 0_i64
      loop do
        batch = where("#{pk_col} > ?", last_id)
          .order(model.primary_key)
          .limit(batch_size)
          .to_a
        break if batch.empty?
        ids = batch.map(&.id.not_nil!)
        # ids are Int64s from the database — safe to interpolate
        yield where(%(#{pk_col} IN (#{ids.join(", ")})))
        last_id = ids.last
        break if batch.size < batch_size
      end
    end

    # --- aggregates ----------------------------------------------------------

    def sum(col : String | Symbol) : Int64
      return 0_i64 if @none_flag
      sql, args = build_sql("sum(#{maybe_qualify(quote(col.to_s))})", [] of String)
      value = Base.__session.query_one?(sql, args: args, as: PG::Numeric?)
      value ? value.to_s.to_i64 : 0_i64
    end

    def minimum(col : String | Symbol) : Int64?
      return nil if @none_flag
      sql, args = build_sql("min(#{maybe_qualify(quote(col.to_s))})", [] of String)
      Base.__session.query_one?(sql, args: args, as: Int64?)
    end

    def maximum(col : String | Symbol) : Int64?
      return nil if @none_flag
      sql, args = build_sql("max(#{maybe_qualify(quote(col.to_s))})", [] of String)
      Base.__session.query_one?(sql, args: args, as: Int64?)
    end

    # Rounded to 2 decimals (matches the oracle normalisation; Rails
    # returns a full-precision BigDecimal).
    def average(col : String | Symbol) : PG::Numeric?
      return nil if @none_flag
      sql, args = build_sql("round(avg(#{maybe_qualify(quote(col.to_s))})::numeric, 2)", [] of String)
      Base.__session.query_one?(sql, args: args, as: PG::Numeric?)
    end

    # Scope methods of the target model, re-emitted as instance methods so
    # `user.rooms.without_directs` merges into the association scope (Rails
    # CollectionProxy delegates to scopes on the relation). The bodies call
    # Relation's own where/order/... — the merge happens naturally.
    macro finished
      {% if @type.type_vars.size > 0 %}
        {% model_name = @type.type_vars.first.stringify %}
        {% for s in ::ActiveRecord::SCOPES %}
          {% if s[0] == model_name %}
            def {{ s[1].id }}({{ s[2].map(&.name).splat }}) : Relation(T)
              {{ s[3] }}
            end
          {% end %}
        {% end %}
      {% end %}
    end
  end
end
