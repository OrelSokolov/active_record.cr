# Schema oracle spec: db/schema.cr must reproduce the Rails 8.1.4 schema.rb
# dump 1:1 (oracle/schema.rb → oracle/schema_expected.cr, captured from the
# ORIGINAL activerecord), and `schema:load` must rebuild a byte-identical
# schema definition from it (round-trip through the scratch database
# crails_ar_schema).

require "spec"
require "../src/active_record_cr"
require "./support/migration_set"

SCHEMA_DB_URL = "postgres://root@/crails_ar_schema?host=/var/run/postgresql"

def reset_schema_db(conn)
  conn.query_all(%(SELECT tablename FROM pg_tables WHERE schemaname = 'public'),
    as: String).each do |t|
    conn.exec(%(DROP TABLE IF EXISTS "#{t}" CASCADE))
  end
end

def dump_columns(conn) : Array(String)
  conn.query_all(%(
    SELECT c.table_name, c.column_name, c.udt_name, c.is_nullable, c.column_default,
           COALESCE(c.character_maximum_length::text, '') AS len,
           COALESCE(c.numeric_precision::text, '') AS nprec,
           COALESCE(c.numeric_scale::text, '') AS nscale,
           COALESCE(c.datetime_precision::text, '') AS dprec
    FROM information_schema.columns c
    JOIN information_schema.tables t
      ON t.table_schema = c.table_schema AND t.table_name = c.table_name
    WHERE c.table_schema = 'public' AND t.table_type = 'BASE TABLE'
      AND c.table_name NOT IN ('schema_migrations', 'ar_internal_metadata')
    ORDER BY c.table_name, c.ordinal_position
  ), as: {String, String, String, String, String?, String, String, String, String})
    .map { |(t, c, udt, nullable, default, len, nprec, nscale, dprec)|
      "#{t}.#{c} #{udt}(#{len},#{nprec},#{nscale},#{dprec}) null=#{nullable} default=#{default.inspect}"
    }
end

def dump_indexes(conn) : Array(String)
  conn.query_all(%(
    SELECT tablename, indexname, indexdef
    FROM pg_indexes
    WHERE schemaname = 'public'
      AND tablename NOT IN ('schema_migrations', 'ar_internal_metadata')
    ORDER BY tablename, indexname
  ), as: {String, String, String})
    .map { |(t, i, defn)| "#{t}.#{i}: #{defn.gsub('"', "")}" }
end

def dump_fks(conn) : Array(String)
  conn.query_all(%(
    SELECT conrelid::regclass::text AS rel, conname, pg_get_constraintdef(oid) AS def
    FROM pg_constraint
    WHERE contype = 'f' AND connamespace = 'public'::regnamespace
    ORDER BY conrelid::regclass::text, conname
  ), as: {String, String, String})
    .map { |(rel, con, defn)| "#{rel}.#{con}: #{defn.gsub('"', "")}" }
end

def dump_checks(conn) : Array(String)
  conn.query_all(%(
    SELECT conrelid::regclass::text AS rel, conname, pg_get_constraintdef(oid) AS def
    FROM pg_constraint
    WHERE contype = 'c' AND conislocal AND connamespace = 'public'::regnamespace
    ORDER BY conrelid::regclass::text, conname
  ), as: {String, String, String})
    .map { |(rel, con, defn)| "#{rel}.#{con}: #{defn.gsub('"', "")}" }
end

def normalized_report(conn) : Array(String)
  {"columns" => dump_columns(conn), "indexes" => dump_indexes(conn),
   "fks" => dump_fks(conn), "checks" => dump_checks(conn)}.flat_map do |section, rows|
    ["-- #{section}"] + rows
  end
end

describe "ActiveRecord schema.cr oracle (expected from activerecord 8.1.4)" do
  it "dumps db/schema.cr 1:1 with the Rails schema.rb oracle" do
    ActiveRecord::Base.establish_connection(SCHEMA_DB_URL)
    conn = ActiveRecord::Base.connection

    reset_schema_db(conn)
    MIGRATIONS.each_with_index do |m, i|
      m.new(20_261_001_000_000 + i).migrate(:up)
    end
    # mirror of the oracle harness: record versions like a real Migrator would
    conn.exec(%(CREATE TABLE IF NOT EXISTS schema_migrations (version bigint NOT NULL PRIMARY KEY)))
    MIGRATIONS.each_with_index do |m, i|
      conn.exec(%(INSERT INTO schema_migrations (version) VALUES ($1)),
        args: [20_261_001_000_000 + i])
    end

    dumped = ActiveRecord::SchemaDumper.dump_cr
    expected = File.read(File.join(__DIR__, "..", "oracle", "schema_expected.cr"))
    dumped.should eq(expected), "\ngot:\n#{dumped}\n\nwant:\n#{expected}"

    # --- round-trip: wipe, reload from the dumped schema.cr, compare ------
    report_before = normalized_report(conn)

    reset_schema_db(conn)

    Dir.mkdir_p("tmp")
    File.write("tmp/schema_roundtrip.cr", dumped)
    File.write("tmp/roundtrip_runner.cr", <<-CODE)
    # Generated by spec/schema_spec.cr — do not edit.
    require "active_record_cr"

    ActiveRecord::Base.establish_connection(#{SCHEMA_DB_URL.inspect})

    require "./schema_roundtrip"
    CODE

    # db/schema.cr requires the shard by name (as in a real app, where it
    # lives in lib/); a shard cannot require itself, so emulate the app
    # layout with a self-symlink in the gitignored lib/.
    Dir.mkdir_p("lib")
    File.symlink("..", "lib/active_record_cr") unless File.symlink?("lib/active_record_cr") || File.exists?("lib/active_record_cr")

    status = Process.run("crystal", ["run", "tmp/roundtrip_runner.cr"])
    status.success?.should be_true

    normalized_report(conn).should eq(report_before)
    conn.query_one(%(SELECT COALESCE(MAX(version), 0) FROM schema_migrations),
      as: Int64).should eq(20_261_001_000_008)
  end
end
